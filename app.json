{
  "expo": {
    "name": "أسطا باشا",
    "slug": "ostabasha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo3.png",
    "scheme": "ostabasha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nancy977.ostabasha"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo4.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nancy977.ostabasha"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo3.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0fd9f093-d336-479f-95e9-709bb4b9d40c"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
